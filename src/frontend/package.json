{
  "name": "vbank-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "openapi-typescript ../../spec/auth.yaml -o src/gen/auth.ts && openapi-typescript ../../spec/operations.yaml -o src/gen/operations.ts",
