        <!-- Cost note -->
        <mxCell id="note" value="&lt;b&gt;Est. monthly cost ≈ $0.01&lt;/b&gt;&lt;br&gt;CloudFront, Lambda, Function URL, CloudWatch, Scheduler: free tier&lt;br&gt;S3 ≈ $0.0001 · EFS ≈ $0.003 · Backup ≈ $0.002&lt;br&gt;+ $0.50 Route 53 zone + domain if custom domain" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
