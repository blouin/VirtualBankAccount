          <mxGeometry x="600" y="280" width="450" height="170" as="geometry" />
        </mxCell>

        <!-- Clients -->
        <mxCell id="browser" value="Web SPA&lt;br&gt;(browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1">
